{
  "name": "obsidian-open-in-terminal",
  "version": "0.11.1",
  "description": "Open your vault in a terminal, launch CLI tools with note context, or run Git commands.",
  "author": "ChenFeng",
  "scripts": {
    "dev": "rollup --config rollup.config.js --watch",
    "build": "node scripts/build.cjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "node tests/regressions.cjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && node scripts/check-release.cjs"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "terminal"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/node": "^20.11.24",
    "eslint": "^9.39.1",
    "eslint-plugin-obsidianmd": "0.4.2",
    "obsidian": "1.13.1",
    "rollup": "^4.9.6",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.46.3"
  }
}
